# Copy to .env for local `supabase functions serve`. The real .env is gitignored.
# `supabase secrets set` does NOT affect local serve — these two are separate stores.

# Rakuten: the Application ID only. Semi-public (it rides in every request URL)
# but still a credential: ~1 req/sec per ID, and a leaked one gets throttled.
RAKUTEN_APP_ID=

# NOT USED by the Ichiba Item Search API. Do not add it here or anywhere in the
# repo. Rakuten cannot regenerate an Access Key — recovering from a leak means
# deleting the app, which also kills the Application ID above. Keep it in a
# password manager, nowhere else.
# RAKUTEN_ACCESS_KEY=  ← intentionally absent

# Affiliate ID: deliberately unused. Passing it to the API makes every response
# return a tracked affiliateUrl instead of itemUrl, which would silently end up
# stored in chatak_offers.url. Not a config toggle — a product decision.
# RAKUTEN_AFFILIATE_ID=  ← intentionally absent

YAHOO_APP_ID=
RESEND_API_KEY=
